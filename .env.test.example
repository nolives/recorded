# Copy this file to .env.test.local and fill in two throwaway test accounts
# (sign them up in the app first). Used only by `npm test` and the checks
# in supabase/checks/. Never commit .env.test.local.
TEST_USER_1_USERNAME=test_user_one
TEST_USER_1_EMAIL=test1@example.test
TEST_USER_1_PASSWORD=choose-a-long-random-password
TEST_USER_2_USERNAME=test_user_two
TEST_USER_2_EMAIL=test2@example.test
TEST_USER_2_PASSWORD=choose-another-long-random-password
